{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "啟動 Streamlit 資料工具版",
      "type": "shell",
      "command": "streamlit run app.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "啟動 FastAPI 後端",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --port 8008",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "啟動 React 前端",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "啟動 React 完整版（後端 + 前端）",
      "dependsOn": ["啟動 FastAPI 後端", "啟動 React 前端"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "跑後端測試",
      "type": "shell",
      "command": "python -m unittest discover -s tests -t .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "跑前端測試",
      "type": "shell",
      "command": "npm.cmd test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
